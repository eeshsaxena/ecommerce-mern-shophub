# Copy to .env for local development. Never commit the real .env.
# On Render / Vercel, set these in the dashboard instead.

# MongoDB Atlas connection string.
# Get one free at https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecommerce?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ecommerce

# Signing key for auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production; the server refuses to boot without it.
JWT_SECRET=

# Shared secret guarding POST /api/seed, which WIPES the product collection.
# Leave unset to disable seeding entirely.
SEED_TOKEN=

# Set by the host in production. Leave unset locally.
# NODE_ENV=production
# PORT=5000
